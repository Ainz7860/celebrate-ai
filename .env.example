# CelebrateAI — Environment Configuration
# Copy this file to .env.local to configure live Gemini / Groq AI integration

# Google Gemini API Key (Required for live GenAI generation & adaptive replanning)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-2.0-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (Optional alternative fast LLM inference provider)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (Default: llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Note: If no API key is configured, CelebrateAI automatically falls back
# to rich deterministic Demo Mode, providing instant, fully populated plans.
